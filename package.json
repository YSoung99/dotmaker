{
  "name": "dotmaker",
  "productName": "도트메이커",
  "version": "3.12.0",
  "description": "캐릭터 그림을 원본 그대로 살린 도트 그림으로 바꾸는 프로그램",
  "author": "YSoung99",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "desktop/main.cjs",
  "desktopName": "dotmaker.desktop",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node tools/build.mjs && electron .",
    "dist:win": "node tools/build.mjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node tools/build.mjs && electron-builder --mac dmg zip --arm64 --publish never -c.productName=DotMaker",
    "dist:linux": "node tools/build.mjs && electron-builder --linux AppImage deb --x64 --publish never -c.productName=DotMaker",
    "dist": "npm run dist:win && npm run dist:mac && npm run dist:linux"
  },
  "build": {
    "appId": "io.github.ysoung99.dotmaker",
    "productName": "도트메이커",
    "artifactName": "DotMaker-${version}-${os}-${arch}.${ext}",
    "files": [
      "desktop/**",
      "!desktop/icons/linux",
      "dist/도트메이커.html",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "도트메이커"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "desktop/icons/linux",
      "syncDesktopName": true,
      "maintainer": "YSoung99 <99796713+YSoung99@users.noreply.github.com>"
    },
    "icon": "desktop/icons/icon.png",
    "publish": {
      "provider": "github",
      "owner": "YSoung99",
      "repo": "dotmaker",
      "releaseType": "release"
    },
    "electronLanguages": [
      "ko",
      "en",
      "en-US"
    ]
  },
  "devDependencies": {
    "@xprite/pixelate": "0.1.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "smart-downscaler": "1.0.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
